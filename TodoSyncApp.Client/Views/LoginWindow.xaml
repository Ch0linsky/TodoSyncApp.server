<Window x:Class="TodoSyncApp.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#ffffff">

    <Border Margin="20" Background="White" Padding="20" CornerRadius="10" BorderBrush="#ccc" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="TodoSyncApp" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Usuario:"/>
            <TextBox Text="{Binding Username}" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="Contraseña:"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,5,0,20"/>

            <Button Content="Iniciar sesión" Padding="10,5" Command="{Binding LoginCommand}" Click="OnLoginClick"/>
        </StackPanel>
    </Border>
</Window>
